# Copier ce fichier en config/.env et remplir les valeurs. Ne jamais le committer.

# Microsoft Teams : URL du webhook d'un flux « Workflows »
# (Teams > canal > ... > Workflows > « Publier dans un canal lorsqu'une requête webhook est reçue »)
TEAMS_WEBHOOK_URL=

# E-mail (SMTP). Office 365 : smtp.office365.com:587 ; Gmail : smtp.gmail.com:587 (mot de passe d'application)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Destinataires séparés par des virgules
MAIL_TO=
